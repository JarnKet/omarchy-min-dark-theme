# Min Dark btop: Omarchy's btop.theme.tpl rendered from colors.toml, with the
# boxes and dividers moved to Min Dark's gray chrome (#444444 focusBorder,
# #383838 dividers) so only the graphs carry color, the way Min keeps color for
# code.
theme[main_bg]="#1f1f1f"
theme[main_fg]="#c1c1c1"
theme[title]="#fafafa"
theme[hi_fg]="#fafafa"
theme[selected_bg]="#383838"
theme[selected_fg]="#c1c1c1"
theme[inactive_fg]="#727272"
theme[graph_text]="#888888"
theme[meter_bg]="#383838"
theme[proc_misc]="#888888"
theme[cpu_box]="#444444"
theme[mem_box]="#444444"
theme[net_box]="#444444"
theme[proc_box]="#444444"
theme[div_line]="#383838"
theme[temp_start]="#85e89d"
theme[temp_mid]="#ffab70"
theme[temp_end]="#f97583"
